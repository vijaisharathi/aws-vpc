# ==============================================================================
# AWS VPC Management Portal - Environment Configuration Template
# Copy this file to .env for local development:
#   copy .env.example .env   (Windows cmd)
#   cp .env.example .env     (Linux / PowerShell / macOS)
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development

# Database Mode (sqlite | rds)
DATABASE_MODE=sqlite

# AWS Cloud Integration Toggle (false = local development without AWS credentials)
AWS_ENABLED=false

# AWS Region for infrastructure deployment and CloudWatch metrics
AWS_REGION=us-east-1

# SQLite Database File Path (defaults to backend/academicdb.sqlite)
SQLITE_DB_PATH=backend/academicdb.sqlite

# ==============================================================================
# Optional Production AWS RDS Configuration (used only when DATABASE_MODE=rds)
# ==============================================================================
# DB_HOST=academic-rds-mysql.c123456789.us-east-1.rds.amazonaws.com
# DB_NAME=academicdb
# DB_USER=dbadmin
# DB_PASS=SecurePassword123!
# DB_SECRET_NAME=academic-vpc-demo-rds-db-secret

