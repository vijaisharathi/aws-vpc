# ==============================================================================
# Git Ignore Configuration for Terraform & Cloud Projects
# ==============================================================================

# Compiled files and local provider caches
.terraform/
.terraform.lock.hcl

# Terraform State Files (Contain sensitive plain-text passwords and resource state)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash Log Files
crash.log
crash.*.log

# Sensitive Variable Definitions
*.tfvars
*.tfvars.json

# Whitelist the example configuration file
!terraform.tfvars.example

# Terraform Plan Files
*.tfplan
*.plan

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# SSH Keys and Certificates
*.pem
*.key
*.pub
id_rsa
id_rsa.*
*.pfx

# Environment files
.env
.env.*
.env.local
!.env.example

# Python caches and local virtual environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/
ENV/

# Local SQLite databases
*.sqlite
*.sqlite3
*.db

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE and Editor Directories
.vscode/
.idea/
*.swp
*.swo
*~

